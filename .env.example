# Kopieren nach .env und anpassen: cp .env.example .env

ENVIRONMENT=production
LOG_LEVEL=INFO

# Frontend darf nur von diesen Origins per CORS auf die API zugreifen.
ALLOWED_ORIGINS=["https://{{TOOLBOX_DOMAIN}}"]

# Redis (Queue + Rate Limiting)
REDIS_URL=redis://toolbox-redis:6379/0

# SQLite Default -- fuer Postgres z.B.:
# DATABASE_URL=postgresql://user:password@toolbox-db:5432/toolbox
DATABASE_URL=sqlite:////data/toolbox.db

# Harte Obergrenzen, siehe docs/ARCHITECTURE.md
DEFAULT_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
SCAN_RATE_LIMIT_PER_MINUTE=5

# --- Auth ---
# WICHTIG: echten Secret generieren, NICHT den Default verwenden:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme-generate-a-real-secret

# Muss exakt zur oeffentlichen Domain passen, sonst schlaegt WebAuthn/Passkey fehl
WEBAUTHN_RP_ID={{TOOLBOX_DOMAIN}}
WEBAUTHN_RP_NAME=Toolbox
WEBAUTHN_ORIGIN=https://{{TOOLBOX_DOMAIN}}

# --- Microsoft 365 SSO (optional) ---
# Einrichtung: Azure Portal -> Microsoft Entra ID -> App-Registrierungen
# -> Neue Registrierung. Redirect-URI (Web) auf
#   <WEBAUTHN_ORIGIN>/api/auth/sso/microsoft/callback
# setzen, z.B. https://{{TOOLBOX_DOMAIN}}/api/auth/sso/microsoft/callback
# (OHNE "/v1" -- das ist die oeffentliche Next.js-Route, nicht der interne Backend-Pfad)
# API-Berechtigungen: Microsoft Graph -> Delegiert -> openid, profile,
# email, User.Read. Client-Secret unter "Zertifikate & Geheimnisse" anlegen.
#
# WICHTIG: SSO-Login ist nur fuer bereits per Admin angelegte Konten
# moeglich -- ein Admin muss jedes Konto unter Benutzerverwaltung mit der
# jeweiligen Microsoft-UPN (z.B. max.mustermann@firma.de) verknuepfen.
# Kein automatisches Anlegen neuer Konten ueber SSO.
MS_SSO_ENABLED=false
MS_SSO_CLIENT_ID=
MS_SSO_CLIENT_SECRET=
MS_SSO_TENANT_ID=

# --- WebSSH-Webshell (gespeicherte SSH-Verbindungen) ---
# Symmetrischer Schluessel zum Verschluesseln gespeicherter SSH-
# Passwoerter/private Schluessel in der DB. Generieren mit:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls NICHT gesetzt: wird ein Schluessel aus SESSION_SECRET abgeleitet
# (funktioniert sofort ohne Zusatzschritt, ein dedizierter Key wird aber
# empfohlen -- getrennte Rotation von Session- und Verschluesselungs-
# schluessel ist sauberer).
SSH_VAULT_KEY=
# Maximale Anzahl gleichzeitig offener WebSSH-Verbindungen PRO NUTZER
MAX_SSH_SESSIONS_PER_USER=5
